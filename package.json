{
  "name": "@richardmcquiston01/sprite-sheet-builder",
  "version": "0.1.0",
  "description": "Generate sprite sheets and companion CSS from directories of images.",
  "keywords": [
    "sprite-sheet",
    "spritesheet",
    "css",
    "images",
    "build-tool"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/sprite-sheet-builder.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sprite-sheet-builder": "./dist/sprite-sheet-builder.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:file": "bun test",
    "lint": "eslint .",
    "lint:file": "eslint",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "maxrects-packer": "^2.7.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bun": "^1.1.14",
    "eslint": "^9.17.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.0"
  }
}
